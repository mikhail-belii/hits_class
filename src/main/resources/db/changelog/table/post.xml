<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="CreatePostTable" author="KBelovodchenko">
        <createTable tableName="post">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_post"/>
            </column>
            <column name="text" type="VARCHAR(2048)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME"/>
            <column name="course_id" type="UUID"/>
            <column name="author_id" type="UUID"/>
            <column name="post_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="deadline" type="DATETIME"/>
            <column name="max_score" type="INT"/>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="author_id"
                                 baseTableName="post"
                                 constraintName="FK_POST_ON_AUTHOR"
                                 referencedColumnNames="id"
                                 referencedTableName="user"/>

        <addForeignKeyConstraint baseColumnNames="course_id"
                                 baseTableName="post"
                                 constraintName="FK_POST_ON_COURSE"
                                 referencedColumnNames="id"
                                 referencedTableName="course"/>
    </changeSet>

    <changeSet id="AddNewPostFieldsForMarkEvaluation" author="KBelovodchenko">
        <dropColumn tableName="post" columnName="max_score"/>
        <addColumn tableName="post">
            <column name="max_score" type="real"/>
        </addColumn>
        <addColumn tableName="post">
            <column name="min_score" type="real"/>
        </addColumn>
        <addColumn tableName="post">
            <column name="multiplier" type="real"/>
        </addColumn>
        <addColumn tableName="post">
            <column name="evaluation_function" type="VARCHAR(16)"/>
        </addColumn>
        <addColumn tableName="post">
            <column name="task_mark_evaluation_type" type="VARCHAR(16)"/>
        </addColumn>
    </changeSet>

    <changeSet id="AddPassThreshold" author="KBelovodchenko">
        <addColumn tableName="post">
            <column name="pass_threshold" type="real"/>
        </addColumn>
    </changeSet>

    <changeSet id="AlterMarkEvaluationTypeSize" author="KBelovodchenko">
        <modifyDataType
                tableName="post"
                columnName="task_mark_evaluation_type"
                newDataType="VARCHAR(64)"/>
    </changeSet>

    <changeSet id="AddAppraisingFields" author="KBelovodchenko">
        <addColumn tableName="post">
            <column name="appraiser_deadline" type="DATETIME"/>
        </addColumn>
        <addColumn tableName="post">
            <column name="student_appraising_number" type="INT"/>
        </addColumn>
        <addColumn tableName="post">
            <column name="task_answer_appraising_type" type="VARCHAR(16)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>